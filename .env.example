# Copy to ignored .env.local for local development. Do not put credentials here.
# These three are required for Auth, workspace and CRM routes at runtime.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key

# Optional: only the signed internal jobs-dispatch route uses these. This
# candidate has no production scheduler or job executor configured.
SUPABASE_SERVICE_ROLE_KEY=
JOBS_DISPATCH_SECRET_CURRENT=
# Optional rotation overlap; remove after the previous signer expires.
JOBS_DISPATCH_SECRET_PREVIOUS=

# Optional browser-test target. CI and NODE_ENV are platform-provided.
PLAYWRIGHT_BASE_URL=http://localhost:3000
